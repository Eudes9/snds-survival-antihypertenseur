learning_curve_results <- rbind(
learning_curve_results,
data.frame(
Training_Size = size * 100,
Accuracy = conf_matrix$overall['Accuracy'],
Precision = conf_matrix$byClass['Pos Pred Value'],
Recall = conf_matrix$byClass['Sensitivity'],
Specificity = conf_matrix$byClass['Specificity'],
F1 = conf_matrix$byClass['F1'],
AUC = auc_value
)
)
}
return(learning_curve_results)
}
# Call the function to compute learning curves
learning_curves_max_depth <- compute_learning_curves(train_data, test_data, dependent_variable, top_3_vars, best_params_max_depth$max.depth)
# Verify results
colnames(learning_curves_max_depth) <- c("Training_Size", "Accuracy", "Precision", "Recall", "Specificity", "F1", "AUC")
str(learning_curves_max_depth)
head(learning_curves_max_depth)
# Reshape data from wide to long format for ggplot
learning_curves_long <- melt(learning_curves_max_depth, id.vars = "Training_Size")
# Plot learning curves
ggplot(learning_curves_long, aes(x = Training_Size, y = value, color = variable)) +
geom_line(size = 1.2) +  # Plot lines for each metric
geom_point(size = 2) +   # Add points for each training size
labs(title = "Learning Curves for Random Forest",
x = "Training Set Size (%)",
y = "Performance Metric",
color = "Metric") +
scale_color_manual(values = c(
"Accuracy" = "blue",
"Precision" = "purple",
"Recall" = "red",
"Specificity" = "orange",
"F1" = "darkgreen",
"AUC" = "green"
)) +
theme_minimal() +  # Clean theme
theme(legend.position = "bottom")  # Move legend to bottom
#Simulation utilsant le modèle optimisé nodesize
simulate_data_kde <- function(test_data, num_samples = 1000) {
# Initialize the simulated data frame with the correct structure and number of rows
simulated_data <- data.frame(matrix(ncol = ncol(test_data), nrow = num_samples))
colnames(simulated_data) <- colnames(test_data)  # Assign column names from test_data
for (feature in colnames(test_data)) {
if (is.numeric(test_data[[feature]])) {
# Estimate density for numeric features
kde <- density(test_data[[feature]], na.rm = TRUE)
# Sample new values from KDE
simulated_data[[feature]] <- sample(kde$x, num_samples, replace = TRUE, prob = kde$y)
} else {
# For categorical variables, sample from existing categories
simulated_data[[feature]] <- sample(test_data[[feature]], num_samples, replace = TRUE)
}
}
return(simulated_data)
}
# Generate synthetic dataset with 1000 samples
simulated_test_data_kde <- simulate_data_kde(test_data_top3, num_samples = 1000)
simulated_predictions_kde <- predict(rf_model_top3_optimized_nodesize, newdata = simulated_test_data_kde, type = "response")
# Convert predictions to factors to match real test data
simulated_predictions_kde <- factor(simulated_predictions_kde, levels = levels(test_data_top3[[dependent_variable]]))
# Convert predictions into a dataframe
simulation_results_kde <- data.frame(Predicted_Class = simulated_predictions_kde)
# Plot class distribution of simulated predictions
ggplot(simulation_results_kde, aes(x = Predicted_Class)) +
geom_bar(fill = "steelblue") +
labs(title = "Simulated Predictions (KDE) - Class Distribution",
x = "Predicted Class",
y = "Count") +
theme_minimal()
# Subset the simulated data to match the size of the real test data (82 rows)
simulated_test_data_kde_reduced <- simulated_test_data_kde[1:nrow(test_data_top3), ]
# Make predictions on the reduced simulated data
simulated_predictions_kde_reduced <- predict(rf_model_top3_optimized_nodesize, newdata = simulated_test_data_kde_reduced, type = "response")
# Convert predictions to factors to match real test data
simulated_predictions_kde_reduced <- factor(simulated_predictions_kde_reduced, levels = levels(test_data_top3[[dependent_variable]]))
# Create the comparison data frame
real_vs_simulated_kde <- data.frame(
Type = rep(c("Real Test Data", "KDE Simulated Data"), each = length(test_data_top3[[dependent_variable]])),
Class = c(as.character(test_data_top3[[dependent_variable]]), as.character(simulated_predictions_kde_reduced))
)
# Now you can plot the distribution comparison
ggplot(real_vs_simulated_kde, aes(x = Class, fill = Type)) +
geom_bar(position = "dodge") +
labs(title = "Comparison of Real vs Simulated Class Distribution (KDE)",
x = "Class",
y = "Count") +
theme_minimal()
