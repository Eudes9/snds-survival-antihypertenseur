lead(housing, 3) - lag(housing, 1) ~
i(country, FloodShock, ref = "France") +
money_supply + exchange_rate +
trade_openness + gdp |
country + month,
cluster = ~country,
data = df
)
# Step 1 — Estimate LP with country interactions
