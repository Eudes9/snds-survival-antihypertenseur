names(data)
# Step 1 — Estimate LP with country interactions
lp_h3 <- feols(
lead(Housing_Service, 3) - lag(Housing_Service, 1) ~
i(country, FloodShock, ref = "France") +
money_supply + exchange_rate +
trade_openness + gdp |
country + month,
cluster = ~country,
data = data
)
lp_h3 <- feols(
lead(Housing_Service, 3) - lag(Housing_Service, 1) ~
i(country, FloodShock, ref = "France") +
Money_Supply + Exchange_Rate +
Trade_Openness + GDP |
country + TimePeriod,
cluster = ~country,
data = data
)
wald(lp_h3,
"country::Italy:FloodShock = country::Germany:FloodShock;
country::Italy:FloodShock = country::Poland:FloodShock;
country::Italy:FloodShock = country::Hungary:FloodShock;
country::Italy:FloodShock = country::Slovakia:FloodShock;
country::Italy:FloodShock = country::Slovenia:FloodShock;
country::Italy:FloodShock = country::Austria:FloodShock;
country::Italy:FloodShock = country::Spain:FloodShock")
wald(lp_h3,
"(country::Hungary:FloodShock +
country::Poland:FloodShock +
country::Slovakia:FloodShock +
country::Slovenia:FloodShock)/4 =
(country::Austria:FloodShock +
country::Germany:FloodShock +
country::Italy:FloodShock +
country::Spain:FloodShock)/4")
lp_both <- feols(
lead(Housing_Service, 3) - lag(Housing_Service, 1) ~
i(country, FloodShock, ref = "France") +
i(country, StormShock, ref = "France") +
Money_Supply + Exchange_Rate +
Trade_Openness + GDP |
country + TimePeriod,
cluster = ~country,
data = data
)
wald(lp_both,
"country::Italy:FloodShock = country::Italy:StormShock")
